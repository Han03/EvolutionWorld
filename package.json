{
  "name": "evolution-world",
  "version": "0.1.0",
  "description": "EvolutionWorld - 无缝世界网络游戏服务端（空壳/骨架版）。HTTP 登录 + WebSocket 实时世界 + SDF 体积地形 + 基础物理，预留可扩展系统框架。",
  "type": "module",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "test:api": "node server/src/scripts/ws-smoke-test.mjs",
    "deploy:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/deploy-local.ps1",
    "deploy:wsl:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/deploy-local.ps1 -Clean",
    "deploy:wsl:status": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/deploy-local.ps1 -Status",
    "deploy:wsl:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/deploy-local.ps1 -StopOnly"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "game-server",
    "mmo",
    "websocket",
    "sdf",
    "volumetric",
    "threejs"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  }
}
